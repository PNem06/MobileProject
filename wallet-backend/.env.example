PORT=8080
HOST=127.0.0.1
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
GOOGLE_APPLICATION_CREDENTIALS=./private/service-account.json
# Fixed UID of the shared system wallet. Do not change it for each admin login.
# Other ACTIVE accounts with role ADMIN read this same wallet through the backend.
ADMIN_UID=FIREBASE_AUTH_UID_OF_GROUP_ADMIN
BANK_CODE=MBBank
BANK_ACCOUNT_NUMBER=YOUR_MBBANK_MAIN_ACCOUNT_NUMBER
RECEIVE_ACCOUNT_NUMBER=YOUR_MBBANK_MAIN_ACCOUNT_NUMBER
BANK_ACCOUNT_NAME=YOUR_NAME_WITHOUT_ACCENTS
# Leave blank when using your personal main account, not a VA.
BANK_SUB_ACCOUNT=
SEPAY_WEBHOOK_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
TOPUP_TTL_MINUTES=15
SETTLEMENT_INTERVAL_SECONDS=30
