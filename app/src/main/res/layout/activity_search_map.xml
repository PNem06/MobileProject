<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 1. Google Maps Fragment (Nền phía dưới) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:ignore="FragmentTagUsage" />

    <!-- 2. Thanh tiêu đề và bộ lọc đè phía trên bản đồ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#80FFFFFF"
        android:elevation="8dp"
        android:orientation="vertical">

        <!-- Top Bar: Nút Back + Tiêu đề -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/btnBackMap"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_arrow_back"
                app:tint="#333333"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/txtMapTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingEnd="28dp"
                android:text="Xem trên bản đồ"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Filter Chips Bar -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipMapTime"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_unselected_white"
                    android:elevation="2dp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Theo tuần"
                    android:textColor="#111111"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipMapGuests"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_unselected_white"
                    android:elevation="2dp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="1 Khách"
                    android:textColor="#111111"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipMapFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_unselected_white"
                    android:elevation="2dp"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Bộ lọc"
                    android:textColor="#111111"
                    android:textSize="13sp" />

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

    <!-- 3. Bottom Sheet kéo vuốt danh sách bài đăng -->
    <LinearLayout
        android:id="@+id/bottomSheetPostList"
        android:layout_width="match_parent"
        android:layout_height="450dp"
        android:background="@drawable/bg_guest_favorite_badge"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        app:behavior_hideable="false"
        app:behavior_peekHeight="200dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <!-- Thanh gạch ngang kéo lên/xuống -->
        <View
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="#CCCCCC" />

        <!-- Số lượng nhà ở tìm thấy -->
        <TextView
            android:id="@+id/txtMapListHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:text="Đang tải danh sách chỗ ở..."
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Danh sách bài viết -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMapPosts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            tools:listitem="@layout/item_search_post" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>