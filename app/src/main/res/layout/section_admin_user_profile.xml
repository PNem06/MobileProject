<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp">

    <TextView
        style="@style/AdminUserText"
        android:text="@string/admin_user_profile_title"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/adminUserProfileSource"
        style="@style/AdminUserTextMuted"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/adminUserProfileCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="#E0E6F2"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/adminUserProfileAvatar"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="@string/admin_user_avatar_description"
                    android:src="@drawable/ic_profile" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/adminUserProfileName"
                        style="@style/AdminUserText"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/adminUserProfileStatus"
                        style="@style/AdminUserTextMuted"
                        android:textColor="@color/admin_user_status_text"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/adminUserProfileInfo"
                style="@style/AdminUserText"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="7dp"
                android:textIsSelectable="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/adminUserProfileStatusButton"
                style="@style/AdminUserStatusButton"
                android:layout_marginTop="12dp"
                android:enabled="false"
                android:text="@string/admin_user_lock" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/adminUserProfilePostsTitle"
        style="@style/AdminUserText"
        android:layout_marginTop="20dp"
        android:text="@string/admin_user_profile_posts"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        style="@style/AdminUserTextMuted"
        android:text="@string/admin_user_profile_posts_hint" />

    <TextView
        android:id="@+id/adminUserProfileEmpty"
        style="@style/AdminUserTextMuted"
        android:layout_marginTop="12dp"
        android:paddingBottom="12dp"
        android:text="@string/admin_user_profile_posts_loading" />

</LinearLayout>