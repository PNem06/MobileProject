<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="154dp"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="false">

    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical">

        <FrameLayout android:id="@+id/postPhotoFrame"
            android:layout_width="match_parent" android:layout_height="155dp">
            <ImageView android:id="@+id/postPhoto"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="centerCrop" android:importantForAccessibility="no" />
            <TextView android:id="@+id/postImageState"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:text="Chưa có ảnh"
                android:fontFamily="@font/sx_noto_sans"
                android:textSize="11sp" android:textColor="#73737B" />
            <TextView android:id="@+id/postBadge"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="7dp" android:layout_marginTop="8dp"
                android:layout_marginEnd="40dp" android:maxLines="2"
                android:paddingHorizontal="8dp" android:paddingVertical="5dp"
                android:fontFamily="@font/sx_fraunces" android:textSize="10sp"
                android:textColor="#171719" android:visibility="gone" />
            <FrameLayout android:id="@+id/postFavoriteButton"
                android:layout_width="31dp" android:layout_height="31dp"
                android:layout_gravity="top|end" android:layout_marginTop="7dp"
                android:layout_marginEnd="6dp" android:clickable="true"
                android:focusable="true" />
            <FrameLayout android:id="@+id/postAvatarFrame"
                android:layout_width="32dp" android:layout_height="32dp"
                android:layout_gravity="bottom|end" android:layout_margin="7dp"
                android:padding="2dp">
                <TextView android:id="@+id/postInitials"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:fontFamily="@font/sx_noto_sans"
                    android:textSize="10sp" android:textColor="#3533CD" />
                <ImageView android:id="@+id/postAvatar"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:importantForAccessibility="no" />
            </FrameLayout>
        </FrameLayout>

        <TextView android:id="@+id/postTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="7dp" android:minHeight="43dp"
            android:maxLines="2" android:ellipsize="end" android:includeFontPadding="false"
            android:fontFamily="@font/sx_fraunces" android:textSize="16sp"
            android:textColor="#171719" />
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="5dp"
            android:orientation="horizontal">
            <TextView android:id="@+id/postPrice"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:maxLines="2" android:includeFontPadding="false"
                android:fontFamily="@font/sx_fraunces" android:textSize="11sp"
                android:textColor="#171719" />
            <TextView android:id="@+id/postRating"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:includeFontPadding="false"
                android:fontFamily="@font/sx_noto_sans" android:textSize="10sp"
                android:textColor="#171719" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
