<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Top Bar: Back Arrow + Search Location Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_arrow_back"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#333333"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/edtSearchLocation"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected_white"
            android:hint="Tìm kiếm địa điểm..."
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Filter Chips Horizontal Scroll -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        android:scrollbars="none"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Location Chip -->
            <TextView
                android:id="@+id/chipLocation"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Địa điểm"
                android:background="@drawable/bg_chip_unselected_white"
                android:textColor="#111111"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="10dp"
                android:textSize="14sp"
                android:elevation="2dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Time Chip -->
            <TextView
                android:id="@+id/chipTime"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Thời gian"
                android:background="@drawable/bg_chip_unselected_white"
                android:textColor="#111111"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="10dp"
                android:textSize="14sp"
                android:elevation="2dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Filters Chip -->
            <LinearLayout
                android:id="@+id/chipFilters"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_chip_unselected_white"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="10dp"
                android:elevation="2dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_filter"
                    android:layout_marginEnd="6dp"
                    app:tint="#333333"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/txtChipFilterLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bộ lọc"
                    android:textColor="#111111"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Sort Chip -->
            <LinearLayout
                android:id="@+id/chipSort"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_chip_unselected_white"
                android:paddingHorizontal="16dp"
                android:elevation="2dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_sort"
                    android:layout_marginEnd="6dp"
                    app:tint="#333333"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/txtChipSortLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sắp xếp"
                    android:textColor="#111111"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Results Count and Map Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/txtResultCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="0 kết quả"
            android:textColor="#888888"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/btnMap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_location_pin"
                android:layout_marginEnd="4dp"
                app:tint="#000000"
                tools:ignore="ContentDescription" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bản đồ"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Post List, Loading and Empty State -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPosts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            tools:listitem="@layout/item_search_post" />

        <ProgressBar
            android:id="@+id/progressResults"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtEmptyResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="Không tìm thấy bài đăng phù hợp."
            android:textColor="#777777"
            android:textSize="15sp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
