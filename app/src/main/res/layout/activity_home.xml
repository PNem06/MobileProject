<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusableInTouchMode="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/homeScreenContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header Bar -->
        <FrameLayout
            android:id="@+id/homeHeader"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingTop="10dp"
            android:background="#FFFFFF">
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbarHome"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:id="@+id/headerHomeContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="13dp">

                    <!-- Search Input Box -->
                    <LinearLayout
                        android:id="@+id/layoutSearch"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:background="@drawable/bg_blank_canvas">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_search"
                            app:tint="#171719"
                            android:importantForAccessibility="no" />

                        <EditText
                            android:id="@+id/edtSearch"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="@null"
                            android:fontFamily="@font/sx_fraunces"
                            android:hint="Bắt đầu tìm kiếm"
                            android:imeOptions="actionSearch"
                            android:inputType="text"
                            android:singleLine="true"
                            android:textColor="#171719"
                            android:textColorHint="#171719"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <!-- Bell / Notification Button -->
                    <FrameLayout
                        android:id="@+id/btnNotification"
                        android:layout_width="42dp"
                        android:layout_height="46dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_notification"
                            app:tint="#171719"
                            android:importantForAccessibility="no" />

                        <!-- Unread Dot Indicator -->
                        <View
                            android:id="@+id/viewUnreadDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="10dp"
                            android:layout_marginEnd="7dp"
                            android:background="@drawable/bg_schedule_status_ongoing"
                            android:visibility="gone" />
                    </FrameLayout>

                </LinearLayout>
            </com.google.android.material.appbar.MaterialToolbar>

            <!-- Header Content: Subpage Mode -->
            <FrameLayout
                android:id="@+id/headerSubpageContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtHeaderTitle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:fontFamily="@font/sx_noto_sans"
                    android:textColor="#171719"
                    android:textSize="24sp"
                    android:layout_marginHorizontal="42dp" />

                <FrameLayout
                    android:id="@+id/btnHeaderBack"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_back_button"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="#171719"
                        android:importantForAccessibility="no" />
                </FrameLayout>
            </FrameLayout>

        </FrameLayout>

        <!-- Filter Chips Frame -->
        <FrameLayout
            android:id="@+id/homeFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible">

            <LinearLayout
                android:id="@+id/layoutHomeFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp"
                android:paddingTop="4dp">

                <!-- Filter 0: Tất cả -->
                <TextView
                    android:id="@+id/btnFilterAll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:minHeight="49dp"
                    android:gravity="center"
                    android:fontFamily="@font/sx_fraunces"
                    android:text="Tất cả"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:background="@drawable/bg_chip_selected_dark"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Filter 1: Còn trống -->
                <TextView
                    android:id="@+id/btnFilterAvailable"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="3dp"
                    android:minHeight="49dp"
                    android:gravity="center"
                    android:fontFamily="@font/sx_fraunces"
                    android:text="Còn trống"
                    android:textColor="#171719"
                    android:textSize="15sp"
                    android:background="@drawable/bg_chip_unselected"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Filter 2: Được yêu thích -->
                <TextView
                    android:id="@+id/btnFilterFavorites"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/sx_fraunces"
                    android:gravity="center"
                    android:minHeight="49dp"
                    android:text="Yêu thích"
                    android:textColor="#171719"
                    android:textSize="15sp" />

            </LinearLayout>
        </FrameLayout>

        <!-- Loading Bar -->
        <ProgressBar
            android:id="@+id/homeProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <!-- Scroll Content Area -->
        <ScrollView
            android:id="@+id/homeScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/homeContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EAEAEA" />

        <!-- Bottom Navigation Bar -->
        <LinearLayout
            android:id="@+id/homeNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="68dp"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:background="#FFFFFF">

            <!-- Tab 0: Khám phá -->
            <LinearLayout
                android:id="@+id/tabExplore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:minHeight="49dp"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Khám phá">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_search"
                    app:tint="#3533CD"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:fontFamily="@font/sx_noto_sans"
                    android:text="Khám phá"
                    android:textColor="#3533CD"
                    android:textSize="10sp" />

                <View
                    android:id="@+id/dotExplore"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_schedule_tab_selected" />
            </LinearLayout>

            <!-- Tab 1: Request -->
            <LinearLayout
                android:id="@+id/tabRequest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:minHeight="49dp"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Request">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_exchange"
                    app:tint="#171719"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:fontFamily="@font/sx_noto_sans"
                    android:text="Request"
                    android:textColor="#171719"
                    android:textSize="10sp" />

                <View
                    android:id="@+id/dotRequest"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_schedule_tab_unselected" />
            </LinearLayout>

            <!-- Tab 2: Lịch -->
            <LinearLayout
                android:id="@+id/tabSchedule"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:minHeight="49dp"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Lịch">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="25dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_calendar"
                    app:tint="#171719" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:fontFamily="@font/sx_noto_sans"
                    android:text="Lịch"
                    android:textColor="#171719"
                    android:textSize="10sp" />

                <View
                    android:id="@+id/dotSchedule"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_schedule_tab_unselected" />
            </LinearLayout>

            <!-- Tab 3: Tin nhắn -->
            <LinearLayout
                android:id="@+id/tabChat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:minHeight="49dp"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Tin nhắn">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_message"
                    app:tint="#171719"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:fontFamily="@font/sx_noto_sans"
                    android:text="Tin nhắn"
                    android:textColor="#171719"
                    android:textSize="10sp" />

                <View
                    android:id="@+id/dotChat"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_schedule_tab_unselected" />
            </LinearLayout>

            <!-- Tab 4: Tài khoản -->
            <LinearLayout
                android:id="@+id/tabAccount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:minHeight="49dp"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Tài khoản">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_profile"
                    app:tint="#171719"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/txtTabAccountLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:fontFamily="@font/sx_noto_sans"
                    android:text="Tài khoản"
                    android:textColor="#171719"
                    android:textSize="10sp" />

                <View
                    android:id="@+id/dotAccount"
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_schedule_tab_unselected" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/homeDrawerMenu"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF"
        app:menu="@menu/menu_home" />

</androidx.drawerlayout.widget.DrawerLayout>
