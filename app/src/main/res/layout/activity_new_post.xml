<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".view.New_Post">
    <RelativeLayout android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:elevation="4dp">
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:background="@drawable/ic_arrow_back"
            android:gravity="center"
            android:textSize="30sp"
            android:textColor="#333333"/>
        <TextView
            android:id="@+id/txtScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Bài Đăng Mới"
            android:fontFamily="serif"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#111111"/>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">
            <TextView
                android:id="@+id/txtScreenSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hãy tạo một bài đăng mới"
                android:fontFamily="serif"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#111111"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chia sẻ chỗ ở với những du khách đang cần"
                android:fontFamily="serif"
                android:textSize="12sp"
                android:textColor="#555555"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="142dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_form_field">
                <LinearLayout
                    android:id="@+id/imagePlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:background="@drawable/bg_blank_canvas"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:background="@drawable/ic_photo"
                        android:drawablePadding="6dp"
                        android:textSize="13sp"
                        android:textColor="#555555" />
                </LinearLayout>
                <HorizontalScrollView
                    android:id="@+id/imagePreviewScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:scrollbars="none"
                    android:visibility="gone">
                    <LinearLayout
                        android:id="@+id/imagePreviewList"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </FrameLayout>
            <TextView
                android:id="@+id/txtImageHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:gravity="center"
                android:text="Chọn ảnh hoặc chụp ảnh mới"
                android:textColor="#555555"
                android:textSize="12sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnChooseImage"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:text="Chọn nhiều ảnh"
                    android:fontFamily="serif"
                    android:textAllCaps="false"
                    android:textColor="#222222"
                    android:backgroundTint="#FFFFFF" />
                <Button
                    android:id="@+id/btnTakePhoto"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:text="Chụp ảnh"
                    android:fontFamily="serif"
                    android:textAllCaps="false"
                    android:textColor="#222222"
                    android:backgroundTint="#FFFFFF" />
            </LinearLayout>

            <TextView style="@style/FormLabel"
                android:text="Tên chỗ ở"
                android:fontFamily="serif"/>
            <EditText
                android:id="@+id/edtTitle" style="@style/FormInput"
                android:hint="Ví dụ: Căn hộ gần Quận 1"
                android:fontFamily="serif"
                android:background="@drawable/bg_blank_canvas"
                android:inputType="textCapSentences"/>

            <TextView style="@style/FormLabel"
                android:text="Điểm đến"
                android:fontFamily="serif" />
            <EditText
                android:id="@+id/edtDestination" style="@style/FormInput"
                android:hint="Ví dụ: Đà Lạt, Lâm Đồng"
                android:fontFamily="serif"
                android:background="@drawable/bg_blank_canvas"
                android:inputType="textPostalAddress" />

            <TextView style="@style/FormLabel"
                android:text="Địa chỉ"
                android:fontFamily="serif"/>
            <EditText
                android:id="@+id/edtAddress" style="@style/FormInput"
                android:hint="Nhập địa chỉ chỗ ở"
                android:background="@drawable/bg_blank_canvas"
                android:fontFamily="serif"
                android:inputType="textPostalAddress"/>
            <Button
                android:id="@+id/btnGetLocation"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="Lấy vị trí hiện tại"
                android:fontFamily="serif"
                android:textAllCaps="false"
                android:backgroundTint="#FFFFFF"
                android:textColor="#222222"/>

            <Button
                android:id="@+id/btnChooseMapLocation"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:text="Chọn vị trí trên bản đồ"
                android:textAllCaps="false"
                android:backgroundTint="#161B61"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/txtCoordinates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chưa chọn vị trí"
                android:fontFamily="serif"
                android:textColor="#555555"
                android:textSize="12sp"/>

            <TextView style="@style/FormLabel"
                android:text="Loại chỗ ở của bạn"
                android:fontFamily="serif"/>
            <Spinner
                android:id="@+id/spinnerPropertyType"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_blank_canvas" />

            <TextView style="@style/FormLabel"
                android:text="Tiện nghi"
                android:fontFamily="serif" />
            <LinearLayout
                android:id="@+id/amenitiesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_form_field"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />

            <TextView style="@style/FormLabel"
                android:text="Thông tin phòng"
                android:fontFamily="serif"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/edtBedroomCount" style="@style/FormInput"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:hint="Phòng ngủ"
                    android:fontFamily="serif"
                    android:inputType="number"
                    android:background="@drawable/bg_blank_canvas"
                    />
                <EditText android:id="@+id/edtBathroomCount" style="@style/FormInput"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:hint="Phòng tắm"
                    android:fontFamily="serif"
                    android:inputType="number"
                    android:background="@drawable/bg_blank_canvas" />
            </LinearLayout>
            <EditText
                android:id="@+id/edtMaxGuests" style="@style/FormInput"
                android:hint="Số khách tối đa"
                android:fontFamily="serif"
                android:inputType="number"
                android:background="@drawable/bg_blank_canvas"/>

            <TextView style="@style/FormLabel"
                android:text="Thời gian cho thuê (Bắt đầu - Kết thúc)"
                android:fontFamily="serif"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/edtStartDate" style="@style/FormInput"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:hint="Từ ngày"
                    android:focusable="false"
                    android:clickable="true"
                    android:fontFamily="serif"
                    android:background="@drawable/bg_blank_canvas"/>
                <EditText
                    android:id="@+id/edtEndDate" style="@style/FormInput"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:hint="Đến ngày"
                    android:focusable="false"
                    android:clickable="true"
                    android:fontFamily="serif"
                    android:background="@drawable/bg_blank_canvas"/>
            </LinearLayout>

            <TextView style="@style/FormLabel"
                android:text="Giá phòng"
                android:fontFamily="serif"/>
            <EditText
                android:id="@+id/edtPrice" style="@style/FormInput"
                android:hint="Ví dụ: 1000000 VNĐ"
                android:fontFamily="serif"
                android:background="@drawable/bg_blank_canvas"
                android:inputType="number" />

            <TextView style="@style/FormLabel"
                android:text="Mô tả chỗ ở"
                android:fontFamily="serif"/>
            <EditText
                android:id="@+id/edtDescription" style="@style/FormInput"
                android:layout_height="110dp"
                android:gravity="top"
                android:hint="Mô tả không gian, tiện ích, quy định..."
                android:background="@drawable/bg_blank_canvas"
                android:fontFamily="serif"
                android:inputType="textCapSentences|textMultiLine"/>
            <TextView style="@style/FormLabel"
                android:text="Thông tin thêm"
                android:fontFamily="serif"/>
            <EditText
                android:id="@+id/edtAdditionalInfo" style="@style/FormInput"
                android:minHeight="72dp"
                android:gravity="top"
                android:hint="Ví dụ: Không hút thuốc..."
                android:background="@drawable/bg_blank_canvas"
                android:fontFamily="serif"
                android:inputType="textCapSentences|textMultiLine"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="28dp"
        android:background="#FFFFFF"
        android:elevation="8dp">
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_request_button_gray"
            app:backgroundTint="@null"
            android:text="Hủy"
            android:fontFamily="serif"
            android:textAllCaps="false"
            android:textColor="#E53935"/>
        <Button android:id="@+id/btnPublish"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_primary_blue"
            app:backgroundTint="@null"
            android:fontFamily="serif"
            android:text="Đăng"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

</LinearLayout>
