<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".view.New_Post">
    <RelativeLayout android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:elevation="4dp">
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:background="@drawable/ic_arrow_back"
            android:gravity="center"
            android:textSize="30sp"
            android:textColor="#333333"/>
        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Bài Đăng Mới"
            android:fontFamily="serif"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#111111"/>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hãy tạo một bài đăng mới"
                android:fontFamily="serif"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#111111"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chia sẻ chỗ ở với những du khách đang cần"
                android:fontFamily="serif"
                android:textSize="12sp"
                android:textColor="#555555"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="145dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_form_field">
                <ImageView
                    android:id="@+id/imgPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="Ảnh xem trước"
                    android:fontFamily="serif"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:background="@drawable/bg_blank_canvas"
                    android:orientation="vertical">
                    <TextView android:id="@+id/txtImageHint"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/ic_photo"
                        android:textSize="36sp"
                        android:textColor="#222222"/>
                    <Button android:id="@+id/btnChooseImage"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:text="Thêm ảnh của bạn"
                        android:fontFamily="serif"
                        android:textAllCaps="false"
                        android:textColor="#222222"
                        android:backgroundTint="#FFFFFF"/>
                </LinearLayout>
            </FrameLayout>

            <TextView style="@style/FormLabel"
                android:text="Tên chỗ ở"
                android:fontFamily="serif"/>
            <EditText
                android:id="@+id/edtTitle" style="@style/FormInput"
                android:hint="Ví dụ: Căn hộ gần Quận 1"
                android:fontFamily="serif"
                android:background="@drawable/bg_blank_canvas"
                android:inputType="textCapSentences"/>

            <TextView style="@style/FormLabel"
                android:text="Địa chỉ"
                android:fontFamily="serif"/>
            <EditText
                android:id="@+id/edtAddress" style="@style/FormInput"
                android:hint="Nhập địa chỉ chỗ ở"
                android:background="@drawable/bg_blank_canvas"
                android:fontFamily="serif"
                android:inputType="textPostalAddress"/>
            <Button
                android:id="@+id/btnGetLocation"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="Lấy vị trí hiện tại"
                android:fontFamily="serif"
                android:textAllCaps="false"
                android:backgroundTint="#FFFFFF"
                android:textColor="#222222"/>
            <TextView
                android:id="@+id/txtCoordinates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chưa chọn vị trí"
                android:fontFamily="serif"
                android:textColor="#555555"
                android:textSize="12sp"/>

            <TextView style="@style/FormLabel"
                android:text="Loại chỗ ở của bạn"
                android:fontFamily="serif"/>
            <Spinner
                android:id="@+id/spinnerPropertyType"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_blank_canvas" />

            <TextView style="@style/FormLabel"
                android:text="Thông tin phòng"
                android:fontFamily="serif"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/edtBedroomCount" style="@style/FormInput"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Phòng ngủ"
                    android:fontFamily="serif"
                    android:hint="1"
                    android:inputType="number"
                    android:background="@drawable/bg_blank_canvas"
                    />
                <EditText android:id="@+id/edtBathroomCount" style="@style/FormInput"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Phòng tắm"
                    android:fontFamily="serif"
                    android:inputType="number"
                    android:background="@drawable/bg_blank_canvas"
                    android:hint="1"/>
            </LinearLayout>
            <EditText
                android:id="@+id/edtMaxGuests" style="@style/FormInput"
                android:text="Số khách tối đa"
                android:fontFamily="serif"
                android:inputType="number"
                android:background="@drawable/bg_blank_canvas"
                android:hint="2"/>

            <TextView style="@style/FormLabel"
                android:text="Thời gian cho thuê (Bắt đầu - Kết thúc)"
                android:fontFamily="serif"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/edtStartDate" style="@style/FormInput"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:hint="Từ ngày"
                    android:focusable="false"
                    android:clickable="true"
                    android:fontFamily="serif"
                    android:background="@drawable/bg_blank_canvas"/>
                <EditText
                    android:id="@+id/edtEndDate" style="@style/FormInput"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:hint="Đến ngày"
                    android:focusable="false"
                    android:clickable="true"
                    android:fontFamily="serif"
                    android:background="@drawable/bg_blank_canvas"/>
            </LinearLayout>

            <TextView style="@style/FormLabel"
                android:text="Mô tả chỗ ở"
                android:fontFamily="serif"/>
            <EditText
                android:id="@+id/edtDescription" style="@style/FormInput"
                android:layout_height="110dp"
                android:gravity="top"
                android:hint="Mô tả không gian, tiện ích, quy định..."
                android:background="@drawable/bg_blank_canvas"
                android:fontFamily="serif"
                android:inputType="textCapSentences|textMultiLine"/>
            <TextView style="@style/FormLabel"
                android:text="Thông tin thêm"/>
            <EditText
                android:id="@+id/edtAdditionalInfo" style="@style/FormInput"
                android:minHeight="72dp"
                android:gravity="top"
                android:hint="Ví dụ: Không hút thuốc..."
                android:background="@drawable/bg_blank_canvas"
                android:fontFamily="serif"
                android:inputType="textCapSentences|textMultiLine"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="28dp"
        android:background="#FFFFFF"
        android:elevation="8dp">
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_request_button_gray"
            app:backgroundTint="@null"
            android:text="Hủy"
            android:fontFamily="serif"
            android:textAllCaps="false"
            android:textColor="#E53935"/>
        <Button android:id="@+id/btnPublish"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_request_button_red"
            app:backgroundTint="@null"
            android:fontFamily="serif"
            android:text="Đăng"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

</LinearLayout>