<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/adminUserProfileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_user_background"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    tools:context=".view.AdminUserDetailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/adminUserProfileBack"
            style="@style/AdminUserProfileButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/admin_user_profile_back" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/adminUserProfileReload"
            style="@style/AdminUserProfileButton"
            android:layout_width="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/admin_users_reload" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/adminUserProfileList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="1"
        tools:listitem="@layout/item_admin_user_post" />

</LinearLayout>