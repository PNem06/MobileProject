<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header Row: Close Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/btnCloseDialog"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Đóng"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_delete"
                app:tint="#333333" />

        </RelativeLayout>

        <!-- Sender Header: Avatar, Name, Date Sent, Badge "Trao đổi chỗ ở" -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgDialogAvatar"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_alignParentStart="true"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_user"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toStartOf="@id/txtBadgeSwap"
                android:layout_toEndOf="@id/imgDialogAvatar"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtDialogSenderName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nguyễn Thị Mai"
                    android:textColor="#111111"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtDialogRequestDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Đã gửi yêu cầu 10/02/2026"
                    android:textColor="#777777"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtBadgeSwap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_badge_swap"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Trao đổi chỗ ở"
                android:textColor="#E65100"
                android:textSize="13sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- Proposed Post Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeColor="#EAEAEA"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <!-- Image -->
                <RelativeLayout
                    android:layout_width="100dp"
                    android:layout_height="76dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgProposedPost"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_blank_canvas"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:layout_margin="4dp"
                        android:src="@drawable/ic_heart_outline"
                        app:tint="#FFFFFF"
                        tools:ignore="ContentDescription" />

                </RelativeLayout>

                <!-- Details Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtProposedTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="Căn hộ tại Quận Hai Bà Trưng"
                        android:textColor="#111111"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Location / Address Row -->
                    <LinearLayout
                        android:id="@+id/layoutProposedAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_location_pin"
                            app:tint="#666666"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:id="@+id/txtProposedAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Chưa cập nhật địa chỉ"
                            android:textColor="#666666"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- Dates & Rating Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_calendar"
                            app:tint="#666666"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:id="@+id/txtProposedDates"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="31/02/2026 - 4/03/2026"
                            android:textColor="#666666"
                            android:textSize="12sp" />

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_star_yellow"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:id="@+id/txtProposedRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:text="4,8"
                            android:textColor="#333333"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 3 Buttons Row: Từ chối | Chuyển thanh toán tiền | Chấp nhận -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- Button 1: Từ chối -->
            <TextView
                android:id="@+id/btnDialogReject"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="0.9"
                android:background="@drawable/bg_btn_light_red"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Từ chối"
                android:textColor="#D32F2F"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Button 2: Chuyển thanh toán tiền -->
            <TextView
                android:id="@+id/btnDialogSwitchMoney"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1.2"
                android:background="@drawable/bg_btn_primary_blue"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="4dp"
                android:text="Chuyển thanh toán tiền"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Button 3: Chấp nhận -->
            <TextView
                android:id="@+id/btnDialogAccept"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="0.9"
                android:background="@drawable/bg_btn_primary_blue"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Chấp nhận"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>