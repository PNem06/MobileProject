<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".view.Detail">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/detailScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="330dp">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/viewPagerImages"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                    <TextView
                        android:id="@+id/btnBack"
                        android:layout_width="46dp"
                        android:layout_height="40dp"
                        android:layout_gravity="top|start"
                        android:layout_margin="16dp"
                        android:background="@drawable/ic_arrow_back"
                        android:gravity="center"
                        android:textColor="#111111"
                        android:textSize="36sp"
                        android:contentDescription="Quay lại"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="16dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnShare"
                            android:layout_width="46dp"
                            android:layout_height="40dp"
                            android:background="@drawable/ic_share"
                            android:gravity="center"
                            android:textColor="#111111"
                            android:textSize="25sp"
                            android:contentDescription="Chia sẻ"/>

                        <TextView
                            android:id="@+id/btnFavorite"
                            android:layout_width="46dp"
                            android:layout_height="50dp"
                            android:layout_marginStart="12dp"
                            android:text="♡"
                            android:gravity="center"
                            android:textColor="#111111"
                            android:textSize="30sp"
                            android:contentDescription="Yêu thích"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtImageCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="16dp"
                        android:background="#CC000000"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="1/1"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"/>

                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-24dp"
                    android:fontFamily="serif"
                    android:background="@drawable/bg_detail_white_panel"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="24dp">

                    <TextView
                        android:id="@+id/txtRoomName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:fontFamily="serif"
                        android:text="Chi tiết chỗ ở"
                        android:textColor="#050505"
                        android:textSize="27sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/txtAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:text="Địa chỉ"
                        android:textColor="#333333"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/txtBedInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:layout_marginTop="5dp"
                        android:gravity="center"
                        android:text="Thông tin phòng"
                        android:textColor="#333333"
                        android:textSize="16sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtRating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textColor="#111111"
                                android:textSize="27sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Đánh giá"
                                android:fontFamily="serif"
                                android:textColor="#111111"
                                android:textSize="14sp"/>

                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="60dp"
                            android:background="#888888"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.4"
                            android:gravity="center"
                            android:text="Chỗ ở\nđược yêu thích"
                            android:fontFamily="serif"
                            android:textColor="#111111"
                            android:textSize="17sp"
                            android:textStyle="bold"/>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="60dp"
                            android:background="#888888"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtReviewCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="#111111"
                                android:textSize="27sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="đánh giá"
                                android:fontFamily="serif"
                                android:textColor="#333333"
                                android:textSize="14sp"/>

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#AAAAAA"/>

                    <TextView
                        android:id="@+id/txtHostName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Chủ nhà"
                        android:fontFamily="serif"
                        android:textColor="#111111"
                        android:textSize="17sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/txtHostDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Thông tin chủ nhà"
                        android:fontFamily="serif"
                        android:textColor="#333333"
                        android:textSize="15sp"/>

                    <TextView
                        android:id="@+id/txtDates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="#333333"
                        android:textSize="15sp"
                        android:fontFamily="serif"/>

                    <TextView
                        android:id="@+id/txtRoomCounts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="#333333"
                        android:textSize="15sp"
                        android:fontFamily="serif"/>

                    <TextView
                        android:id="@+id/txtAmenities"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textColor="#333333"
                        android:textSize="15sp"
                        android:lineSpacingExtra="4dp"
                        android:fontFamily="serif"/>

                    <TextView
                        android:id="@+id/txtAdditionalInformation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textColor="#333333"
                        android:textSize="15sp"
                        android:fontFamily="serif"/>

                    <TextView
                        android:id="@+id/txtLocation"
                        android:layout_width="match_parent"
                        android:layout_height="17dp"
                        android:layout_marginTop="10dp"
                        android:fontFamily="serif"
                        android:textColor="#333333"
                        android:textSize="15sp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="#AAAAAA"/>

                    <TextView
                        android:id="@+id/txtDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="#222222"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp"
                        android:fontFamily="serif"/>

                    <TextView
                        android:id="@+id/txtPrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="#FF3035"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp"
                        android:fontFamily="serif"/>

                    <TextView
                        android:id="@+id/btnShowMore"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_request_button_gray"
                        android:gravity="center"
                        android:text="Hiển thị thêm"
                        android:textColor="#111111"
                        android:textSize="16sp"
                        android:fontFamily="serif"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="#AAAAAA"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Bạn thấy nơi này như thế nào?"
                        android:textColor="#111111"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:fontFamily="serif"/>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_request_button_gray"
                                android:padding="12dp"
                                android:text="Chất lượng giấc ngủ"
                                android:textSize="14sp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:background="@drawable/bg_request_button_gray"
                                android:padding="12dp"
                                android:text="Tiếng ồn"
                                android:textSize="14sp"
                                android:fontFamily="serif"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_request_button_gray"
                                android:padding="12dp"
                                android:text="Khung cảnh đẹp"
                                android:textSize="14sp"
                                android:fontFamily="serif"/>

                        </LinearLayout>

                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/txtReviews"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textColor="#222222"
                        android:textSize="16sp"
                        android:lineSpacingExtra="5dp"
                        android:fontFamily="serif"/>

                    <TextView
                        android:id="@+id/btnAllReviews"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_request_button_gray"
                        android:gravity="center"
                        android:text="Xem đánh giá"
                        android:textColor="#111111"
                        android:textSize="16sp"
                        android:fontFamily="serif"/>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="88dp"
            android:background="#FAFAFA"
            android:elevation="10dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/btnMessage"
                android:layout_width="10dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_request_button_red"
                android:gravity="center"
                android:padding="4dp"
                android:text="Nhắn tin tư vấn"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                android:fontFamily="serif"/>

            <TextView
                android:id="@+id/btnBooking"
                android:layout_width="10dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_request_button_red"
                android:gravity="center"
                android:padding="4dp"
                android:text="Đặt phòng"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                android:fontFamily="serif"/>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>