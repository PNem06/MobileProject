<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardPost"
    android:layout_width="154dp"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="13dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Photo Container -->
        <FrameLayout
            android:id="@+id/postPhotoFrame"
            android:layout_width="match_parent"
            android:layout_height="155dp"
            android:background="#EDEDED">

            <ImageView
                android:id="@+id/postPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/postImageState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Chưa có ảnh"
                android:fontFamily="@font/sx_noto_sans"
                android:textColor="#73737B"
                android:textSize="11sp" />

            <!-- Availability / Favorite Badge -->
            <TextView
                android:id="@+id/postBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="40dp"
                android:maxLines="2"
                android:paddingHorizontal="8dp"
                android:paddingVertical="5dp"
                android:background="@drawable/bg_white"
                android:fontFamily="@font/sx_fraunces"
                android:textColor="#171719"
                android:textSize="10sp"
                android:visibility="gone" />

            <!-- Favorite Button -->
            <FrameLayout
                android:id="@+id/postFavoriteButton"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="7dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/favoriteGlyph"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_heart_outline"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <!-- Host Avatar Frame -->
            <FrameLayout
                android:id="@+id/postAvatarFrame"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="7dp"
                android:padding="2dp"
                android:background="@drawable/bg_white">

                <TextView
                    android:id="@+id/postInitials"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:fontFamily="@font/sx_noto_sans"
                    android:textColor="#3533CD"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/postAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />
            </FrameLayout>

        </FrameLayout>

        <!-- Post Title -->
        <TextView
            android:id="@+id/postTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:minHeight="43dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:fontFamily="@font/sx_fraunces"
            android:textColor="#171719"
            android:textSize="16sp" />

        <!-- Price & Rating Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/postPrice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="2"
                android:includeFontPadding="false"
                android:fontFamily="@font/sx_fraunces"
                android:textColor="#171719"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/postRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:includeFontPadding="false"
                android:fontFamily="@font/sx_noto_sans"
                android:textColor="#171719"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
