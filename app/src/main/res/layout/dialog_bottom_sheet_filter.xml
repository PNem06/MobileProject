<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:paddingHorizontal="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- Tiêu đề -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Bộ lọc tìm kiếm"
            android:fontFamily="serif"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#111111" />

        <TextView
            android:id="@+id/txtResetFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:text="Thiết lập lại"
            android:textSize="13sp"
            android:textColor="#E53935"
            android:clickable="true"
            android:focusable="true" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="#EEEEEE" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:fillViewport="false"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <!-- Loại chỗ ở -->
            <TextView
                style="@style/FormLabel"
                android:text="Loại chỗ ở"
                android:fontFamily="serif" />

            <Spinner
                android:id="@+id/spinnerFilterPropertyType"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_blank_canvas" />

            <!-- Tiện nghi -->
            <TextView
                style="@style/FormLabel"
                android:text="Tiện nghi"
                android:fontFamily="serif" />

            <LinearLayout
                android:id="@+id/filterAmenitiesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_form_field"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />

            <!-- Số phòng ngủ và phòng tắm -->
            <TextView
                style="@style/FormLabel"
                android:text="Thông tin phòng"
                android:fontFamily="serif" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edtFilterBedroomCount"
                    style="@style/FormInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:hint="Phòng ngủ"
                    android:inputType="number"
                    android:fontFamily="serif"
                    android:background="@drawable/bg_blank_canvas" />

                <EditText
                    android:id="@+id/edtFilterBathroomCount"
                    style="@style/FormInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:hint="Phòng tắm"
                    android:inputType="number"
                    android:fontFamily="serif"
                    android:background="@drawable/bg_blank_canvas" />
            </LinearLayout>

            <!-- Số khách tối đa -->
            <TextView
                style="@style/FormLabel"
                android:text="Số khách tối đa"
                android:fontFamily="serif" />

            <EditText
                android:id="@+id/edtFilterMaxGuests"
                style="@style/FormInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Nhập số khách tối thiểu cần đáp ứng"
                android:inputType="number"
                android:fontFamily="serif"
                android:background="@drawable/bg_blank_canvas" />

        </LinearLayout>
    </ScrollView>

    <!-- Nút thao tác -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="4dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyFilter"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Áp dụng bộ lọc"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#0F113D"
            app:cornerRadius="10dp" />

    </LinearLayout>

</LinearLayout>
