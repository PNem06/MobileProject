<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="Lọc trạng thái yêu cầu"
        android:textColor="#111111"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:text="Chọn một hoặc nhiều trạng thái để hiển thị"
        android:textColor="#666666"
        android:textSize="13sp" />

    <CheckBox
        android:id="@+id/chkFilterPending"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:checked="true"
        android:text="Đang chờ (chờ phản hồi / duyệt)"
        android:textColor="#222222"
        android:textSize="15sp" />

    <CheckBox
        android:id="@+id/chkFilterAccepted"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:checked="true"
        android:text="Đã chấp nhận"
        android:textColor="#222222"
        android:textSize="15sp" />

    <CheckBox
        android:id="@+id/chkFilterCancelled"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:checked="true"
        android:text="Đã hủy / Từ chối"
        android:textColor="#222222"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnResetFilter"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Tất cả"
            android:textColor="#666666" />

        <Button
            android:id="@+id/btnApplyFilter"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#FF3035"
            android:text="Áp dụng"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</LinearLayout>