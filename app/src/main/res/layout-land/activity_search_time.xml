<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Header bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/txtCancelTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Hủy"
            android:textColor="#666666"
            android:textSize="15sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:id="@+id/txtTitleTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Thời gian ?"
            android:textColor="#000000"
            android:textSize="17sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E5E5" />

    <!-- Tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:weightSum="2"
        android:background="#FFFFFF">

        <!-- Tab: Tự chọn -->
        <LinearLayout
            android:id="@+id/tabCustom"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/txtTabCustom"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Tự chọn"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/indicatorCustom"
                android:layout_width="120dp"
                android:layout_height="2dp"
                android:background="#333333" />

        </LinearLayout>

        <!-- Tab: Linh hoạt -->
        <LinearLayout
            android:id="@+id/tabFlexible"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/txtTabFlexible"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Linh hoạt"
                android:textColor="#888888"
                android:textSize="15sp" />

            <View
                android:id="@+id/indicatorFlexible"
                android:layout_width="120dp"
                android:layout_height="2dp"
                android:background="#333333"
                android:visibility="invisible" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E5E5" />

    <!-- Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- CUSTOM CONTENT -->
        <ScrollView
            android:id="@+id/scrollCustomContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/layoutCustomContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Date flexibility chips -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipExact"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Chính xác"
                            android:background="@drawable/bg_chip_selected_dark"
                            android:textColor="#FFFFFF"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:layout_marginEnd="8dp"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/chip1Day"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="± 1 ngày"
                            android:background="@drawable/bg_chip_unselected_white"
                            android:textColor="#111111"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:layout_marginEnd="8dp"
                            android:textSize="13sp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/chip3Days"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="± 3 ngày"
                            android:background="@drawable/bg_chip_unselected_white"
                            android:textColor="#111111"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:layout_marginEnd="8dp"
                            android:textSize="13sp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/chip7Days"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="± 7 ngày"
                            android:background="@drawable/bg_chip_unselected_white"
                            android:textColor="#111111"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"
                            android:textSize="13sp"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Calendar month navigation -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <ImageView
                        android:id="@+id/btnPrevMonth"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_arrow_back"
                        android:clickable="true"
                        android:focusable="true"
                        app:tint="#333333"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:id="@+id/txtMonthYear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="Tháng 10, 2026"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/btnNextMonth"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_arrow_next"
                        android:clickable="true"
                        android:focusable="true"
                        app:tint="#333333"
                        tools:ignore="ContentDescription" />

                </RelativeLayout>

                <!-- Weekday header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:orientation="horizontal"
                    android:weightSum="7"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Mon"
                        android:textColor="#222222"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Tue"
                        android:textColor="#222222"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Wed"
                        android:textColor="#222222"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Thu"
                        android:textColor="#222222"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Fri"
                        android:textColor="#222222"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Sat"
                        android:textColor="#222222"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Sun"
                        android:textColor="#222222"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Calendar -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerCalendar"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />

                <!-- Selected dates -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/txtStartDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Bắt đầu: 23/10/2026"
                        android:textColor="#000000"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtEndDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Kết thúc: 25/10/2026"
                        android:textColor="#000000"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- FLEXIBLE CONTENT -->
        <ScrollView
            android:id="@+id/layoutFlexibleContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Duration selection -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bạn muốn ở trong bao lâu?"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/chipFlex1Week"
                        android:layout_width="90dp"
                        android:layout_height="40dp"
                        android:text="1 Tuần"
                        android:background="@drawable/bg_chip_selected_dark"
                        android:textColor="#FFFFFF"
                        android:gravity="center"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipFlex2Weeks"
                        android:layout_width="90dp"
                        android:layout_height="40dp"
                        android:text="2 Tuần"
                        android:background="@drawable/bg_chip_unselected_white"
                        android:textColor="#111111"
                        android:gravity="center"
                        android:textSize="14sp"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chipFlex1Month"
                        android:layout_width="90dp"
                        android:layout_height="40dp"
                        android:text="1 Tháng"
                        android:background="@drawable/bg_chip_unselected_white"
                        android:textColor="#111111"
                        android:gravity="center"
                        android:textSize="14sp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

                <!-- Month selection -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bạn muốn ở khi nào?"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Month 1 -->
                    <LinearLayout
                        android:id="@+id/cardMonth1"
                        android:layout_width="90dp"
                        android:layout_height="80dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_month_card_selected"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/txtMonthTitle1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tháng 10"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtYearTitle1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2026"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <!-- Month 2 -->
                    <LinearLayout
                        android:id="@+id/cardMonth2"
                        android:layout_width="90dp"
                        android:layout_height="80dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_month_card_unselected"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/txtMonthTitle2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tháng 11"
                            android:textColor="#111111"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtYearTitle2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2026"
                            android:textColor="#555555"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <!-- Month 3 -->
                    <LinearLayout
                        android:id="@+id/cardMonth3"
                        android:layout_width="90dp"
                        android:layout_height="80dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_month_card_unselected"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/txtMonthTitle3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tháng 12"
                            android:textColor="#111111"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtYearTitle3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2026"
                            android:textColor="#555555"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- Confirm Button -->
    <Button
        android:id="@+id/btnNextTime"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="6dp"
        android:text="Xác nhận"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:backgroundTint="#222222" />

</LinearLayout>
