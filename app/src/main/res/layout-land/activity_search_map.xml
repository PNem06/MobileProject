<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 1. Map Fragment -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:ignore="FragmentTagUsage" />

    <!-- 2. Header and filter bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:elevation="8dp"
        android:background="#80FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/btnBackMap"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_arrow_back"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#333333"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/txtMapTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Xem trên bản đồ"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:paddingEnd="28dp" />

            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipMapTime"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Theo tuần"
                        android:background="@drawable/bg_chip_unselected_white"
                        android:textColor="#111111"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:layout_marginEnd="6dp"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chipMapGuests"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="1 Khách"
                        android:background="@drawable/bg_chip_unselected_white"
                        android:textColor="#111111"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:layout_marginEnd="6dp"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/chipMapFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Bộ lọc"
                        android:background="@drawable/bg_chip_unselected_white"
                        android:textColor="#111111"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:textSize="12sp" />

                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </LinearLayout>

    <!-- 3. Bottom Sheet -->
    <LinearLayout
        android:id="@+id/bottomSheetPostList"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:orientation="vertical"
        android:background="@drawable/bg_guest_favorite_badge"
        android:elevation="12dp"
        android:paddingTop="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_peekHeight="120dp"
        app:behavior_hideable="false">

        <View
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="#CCCCCC"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txtMapListHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Đang tải danh sách chỗ ở..."
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMapPosts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            tools:listitem="@layout/item_search_post" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
