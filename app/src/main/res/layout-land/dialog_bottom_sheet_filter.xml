<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <!-- Tiêu đề & Reset nằm ngang -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bộ lọc tìm kiếm"
            android:fontFamily="serif"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#111111" />

        <TextView
            android:id="@+id/txtResetFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Thiết lập lại"
            android:textSize="14sp"
            android:textColor="#E53935"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE" />

    <!-- Content cuộn -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <!-- Chia 2 cột dọc -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:paddingTop="12dp">

            <!-- Cột trái: Loại chỗ ở, Thông tin phòng, Số khách -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="12dp">

                <TextView
                    style="@style/FormLabel"
                    android:text="Loại chỗ ở"
                    android:fontFamily="serif" />

                <Spinner
                    android:id="@+id/spinnerFilterPropertyType"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_blank_canvas" />

                <TextView
                    style="@style/FormLabel"
                    android:text="Thông tin phòng"
                    android:fontFamily="serif" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/edtFilterBedroomCount"
                        style="@style/FormInput"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:hint="Phòng ngủ"
                        android:inputType="number"
                        android:fontFamily="serif"
                        android:background="@drawable/bg_blank_canvas"
                        android:importantForAutofill="no" />

                    <EditText
                        android:id="@+id/edtFilterBathroomCount"
                        style="@style/FormInput"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:hint="Phòng tắm"
                        android:inputType="number"
                        android:fontFamily="serif"
                        android:background="@drawable/bg_blank_canvas"
                        android:importantForAutofill="no" />
                </LinearLayout>

                <TextView
                    style="@style/FormLabel"
                    android:text="Số khách tối đa"
                    android:fontFamily="serif" />

                <EditText
                    android:id="@+id/edtFilterMaxGuests"
                    style="@style/FormInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Nhập số khách tối thiểu cần đáp ứng"
                    android:inputType="number"
                    android:fontFamily="serif"
                    android:background="@drawable/bg_blank_canvas"
                    android:importantForAutofill="no" />

            </LinearLayout>

            <!-- Cột phải: Tiện nghi -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    style="@style/FormLabel"
                    android:text="Tiện nghi"
                    android:fontFamily="serif" />

                <LinearLayout
                    android:id="@+id/filterAmenitiesList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_form_field"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Nút Apply ở dưới cùng -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyFilter"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Áp dụng bộ lọc"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#0F113D"
            app:cornerRadius="10dp" />
    </LinearLayout>

</LinearLayout>
