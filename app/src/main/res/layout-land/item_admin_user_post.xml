<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#E0E6F2"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Reduced image height for landscape grid -->
        <ImageView
            android:id="@+id/adminUserPostCover"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="#EEF2FF"
            android:contentDescription="@string/admin_user_post_image_description"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_photo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/adminUserPostTitle"
                style="@style/AdminUserText"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/adminUserPostAddress"
                style="@style/AdminUserTextMuted"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/adminUserPostStatus"
                style="@style/AdminUserTextMuted"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/adminUserPostDescription"
                style="@style/AdminUserText"
                android:layout_marginTop="6dp"
                android:textSize="13sp"
                android:ellipsize="end"
                android:maxLines="3" />

            <TextView
                android:id="@+id/adminUserPostDetails"
                style="@style/AdminUserText"
                android:layout_marginTop="6dp"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"
                android:textIsSelectable="true"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/adminUserPostMore"
                style="@style/AdminUserProfileButton"
                android:layout_marginTop="8dp"
                android:textSize="12sp"
                android:text="@string/admin_user_post_more" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>