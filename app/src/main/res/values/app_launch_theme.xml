<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background color of the splash screen -->
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <!-- The splash screen animated icon (transparent để nhường chỗ cho custom overlay) -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/transparent_icon</item>
        <!-- The theme to switch to after the splash screen finishes -->
        <item name="postSplashScreenTheme">@style/Theme.MobileProject</item>
    </style>
</resources>
